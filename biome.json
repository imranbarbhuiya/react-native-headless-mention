{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": { "actions": { "source": { "organizeImports": "off" } } },
	"linter": {
		"enabled": false
	},
	"formatter": {
		"lineWidth": 120,
		"lineEnding": "lf",
		"indentWidth": 4,
		"indentStyle": "tab",
		"includes": ["**", "!**/package.json"]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all",
			"quoteProperties": "asNeeded"
		}
	},
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git"
	}
}
