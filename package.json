{
	"name": "react-native-headless-mention",
	"version": "1.2.6",
	"description": "A headless react native mention component for both iOS and Android.",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"sideEffects": false,
	"license": "MIT",
	"author": "@imranbarbhuiya",
	"scripts": {
		"docs": "typedoc",
		"lint": "eslint src tests --fix --cache",
		"format": "biome check --write .",
		"test": "jest",
		"test:watch": "jest --watch",
		"update": "yarn upgrade-interactive",
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.eslint.json",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run",
		"prepack": "yarn build && pinst --disable",
		"postinstall": "husky .github/husky",
		"postpack": "pinst --enable",
		"coverage": "jest --coverage"
	},
	"keywords": [
		"react native",
		"expo",
		"mention",
		"headless",
		"headless ui",
		"hashtag",
		"tag"
	],
	"dependencies": {
		"diff": "9.0.0"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-native": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@favware/cliff-jumper": "^6.1.0",
		"@favware/npm-deprecate": "^2.0.0",
		"@react-native/babel-preset": "^0.86.1",
		"@react-native/jest-preset": "^0.86.1",
		"@react-native/typescript-config": "^0.86.1",
		"@testing-library/react-native": "^14.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.17",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^9.39.5",
		"eslint-config-mahir": "^1.3.1",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"lint-staged": "^17.2.0",
		"pinst": "^3.0.0",
		"react": "^19.2.8",
		"react-native": "^0.86.0",
		"test-renderer": "^1.2.0",
		"tsdown": "^0.22.14",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3"
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/imranbarbhuiya/react-native-headless-mention.git"
	},
	"bugs": {
		"url": "https://github.com/imranbarbhuiya/react-native-headless-mention/issues"
	},
	"homepage": "https://github.com/imranbarbhuiya/react-native-headless-mention#readme",
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"lint-staged": {
		"*.{mjs,js,ts}": "eslint --fix"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"packageManager": "yarn@4.17.1"
}
